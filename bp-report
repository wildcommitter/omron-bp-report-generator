#!/usr/bin/env bash
# bp-report — launcher for the bp-report podman image.
#
# Three modes:
#   1. CSV  (default)   Build a report from one or more OMRON CSV exports.
#   2. --daemon         Listen for the BLE meter, pull-and-rebuild on press.
#   3. --pair           First-time pairing: program the omblepy key.
#
# Modes 2 and 3 need access to the host's BlueZ DBus socket; the launcher
# adds the bind-mounts and --net=host flags automatically.
set -euo pipefail

usage() {
    cat <<EOF
Usage:
  $(basename "$0") INPUT.csv [MORE.csv ...] [-o OUTPUT_DIR] [--pdf | --md]
  $(basename "$0") --daemon --device MODEL --mac MAC [-o OUTPUT_DIR] [--pdf | --md] [--time-sync] [--pair-key HEX]
  $(basename "$0") --pair   --device MODEL --mac MAC [--pair-key HEX]

CSV mode (default):
  INPUT.csv              path to an OMRON CSV export (required, ≥1)
  MORE.csv ...           additional CSVs; merged with INPUT before analysis
  -o, --output DIR       where to write outputs (default: dir of first input)
  --pdf                  produce report.pdf (default)
  --md                   produce report.md
  -h, --help             show this help

Daemon / pair modes:
  --device, -d MODEL     hem-7361t, hem-7322t, … (run \`omblepy-rs list-devices\`)
  --mac,    -m MAC       Bluetooth MAC of the meter (XX:XX:XX:XX:XX:XX)
  --pair-key HEX         override the 32-char-hex pairing key
  --time-sync            sync the meter's clock each session (daemon only)

In daemon mode the launcher mounts /run/dbus into the container and
runs --net=host so the binary inside can reach the host's BlueZ.
The container stays running until Ctrl-C / SIGTERM.

Build the image first with:
  podman build -t bp-report .
EOF
}

INPUTS=()
OUTPUT_DIR=""
FORMAT_ARGS=()
IMAGE="${BP_REPORT_IMAGE:-bp-report}"
MODE=csv
DEVICE=""
MAC=""
PAIR_KEY=""
TIME_SYNC=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        -o|--output) OUTPUT_DIR="$2"; shift 2 ;;
        --md|--markdown|--pdf) FORMAT_ARGS+=("$1"); shift ;;
        --daemon) MODE=daemon; shift ;;
        --pair)   MODE=pair; shift ;;
        -d|--device) DEVICE="$2"; shift 2 ;;
        -m|--mac) MAC="$2"; shift 2 ;;
        --pair-key) PAIR_KEY="$2"; shift 2 ;;
        --time-sync) TIME_SYNC=1; shift ;;
        -h|--help) usage; exit 0 ;;
        --) shift; break ;;
        -*) echo "unknown option: $1" >&2; usage >&2; exit 2 ;;
        *) INPUTS+=("$1"); shift ;;
    esac
done

if ! podman image exists "$IMAGE"; then
    echo "image '$IMAGE' not present locally — trying podman pull…" >&2
    if ! podman pull "$IMAGE"; then
        echo "error: image '$IMAGE' is not available locally or in the registry." >&2
        echo "  if it's a local image, build it with:" >&2
        echo "    podman build -t $IMAGE $(dirname "$(realpath "$0")")" >&2
        exit 1
    fi
fi

# --- Daemon / pair modes ---
if [[ $MODE != csv ]]; then
    if [[ ${#INPUTS[@]} -gt 0 ]]; then
        echo "error: CSV inputs are not allowed with --$MODE" >&2
        exit 2
    fi
    if [[ -z $DEVICE || -z $MAC ]]; then
        echo "error: --$MODE requires --device and --mac" >&2
        usage >&2
        exit 2
    fi

    # Output dir defaults to cwd for daemon mode (input.csv lands there).
    if [[ -z $OUTPUT_DIR ]]; then OUTPUT_DIR="$(pwd)"; fi
    mkdir -p "$OUTPUT_DIR"
    OUT_ABS="$(realpath "$OUTPUT_DIR")"

    # BlueZ runs on the system bus; the path differs between distros.
    DBUS_MOUNTS=()
    if [[ -e /run/dbus ]]; then
        DBUS_MOUNTS+=(-v /run/dbus:/run/dbus)
    elif [[ -e /var/run/dbus ]]; then
        DBUS_MOUNTS+=(-v /var/run/dbus:/var/run/dbus)
    else
        echo "warning: neither /run/dbus nor /var/run/dbus exists on host;" >&2
        echo "         the container won't be able to reach BlueZ." >&2
    fi

    ENV_ARGS=(-e "BP_DEVICE=$DEVICE" -e "BP_MAC=$MAC")
    if [[ -n $PAIR_KEY ]]; then ENV_ARGS+=(-e "BP_PAIR_KEY=$PAIR_KEY"); fi
    if [[ $MODE == daemon && $TIME_SYNC == 1 ]]; then
        ENV_ARGS+=(-e "BP_TIME_SYNC=1")
    fi

    if [[ $MODE == pair ]]; then
        echo "Pairing mode — make sure the meter is in pairing mode now."
        exec podman run --rm \
            --net=host \
            "${DBUS_MOUNTS[@]}" \
            "${ENV_ARGS[@]}" \
            -v "$OUT_ABS:/data:Z" \
            "$IMAGE" --pair
    fi

    echo "daemon: device=$DEVICE mac=$MAC output=$OUT_ABS"
    echo "        press the meter's BT button when you want to pull readings."
    echo "        Ctrl-C to stop."
    exec podman run --rm \
        --net=host \
        "${DBUS_MOUNTS[@]}" \
        "${ENV_ARGS[@]}" \
        -v "$OUT_ABS:/data:Z" \
        "$IMAGE" --daemon "${FORMAT_ARGS[@]}"
fi

# --- CSV mode (existing behaviour) ---
if [[ ${#INPUTS[@]} -eq 0 ]]; then
    echo "error: at least one INPUT.csv is required" >&2
    usage >&2
    exit 2
fi
for f in "${INPUTS[@]}"; do
    if [[ ! -f $f ]]; then
        echo "error: not a regular file: $f" >&2
        exit 1
    fi
done

FIRST_ABS="$(realpath "${INPUTS[0]}")"
if [[ -z $OUTPUT_DIR ]]; then
    OUTPUT_DIR="$(dirname "$FIRST_ABS")"
fi
mkdir -p "$OUTPUT_DIR"
OUT_ABS="$(realpath "$OUTPUT_DIR")"

# Build the mount + path argument lists, one per input.  Each input is mounted
# read-only at /inputs/input_N.csv inside the container so duplicate basenames
# on the host don't collide.
MOUNT_ARGS=()
PATH_ARGS=()
for i in "${!INPUTS[@]}"; do
    ABS="$(realpath "${INPUTS[$i]}")"
    CN="/inputs/input_$((i + 1)).csv"
    MOUNT_ARGS+=(-v "$ABS:$CN:ro,Z")
    PATH_ARGS+=("$CN")
done

echo "inputs:"
for f in "${INPUTS[@]}"; do
    echo "   $(realpath "$f")"
done
echo "output: $OUT_ABS"
exec podman run --rm \
    -v "$OUT_ABS:/data:Z" \
    "${MOUNT_ARGS[@]}" \
    "$IMAGE" "${PATH_ARGS[@]}" "${FORMAT_ARGS[@]}"
